VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7EH2RU-X-mLLyvCtlGA7ZQ_v3zevafU

# The Google sign-in's OAuth client id — also public (it is in the address of
# every Google sign-in screen). With it set, the app opens Google's own
# sign-in box, which names crumbs-up.com instead of the Supabase address.
# The client *secret* lives only in the Supabase dashboard, never here.
VITE_GOOGLE_CLIENT_ID=553164205082-550f3hohkirk0udadkf0415icum663aj.apps.googleusercontent.com

# Copy to `.env.local` for development, or set these wherever the app is built.
# Without them the app runs exactly as before: no accounts, everything on the device.

# Accounts and sync (Supabase). Both values are public by design — the
# publishable key only reaches what the database's row-level rules allow.
# Never put the secret key (sb_secret_…) or the database password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
